{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nyxion:heredity:sdk:1:sandbox-module",
  "title": "NyXion Heredity Aegis WebAssembly module manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "version", "sdk_api",
    "min_heredity_version", "permissions", "module"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "version": {"$ref": "#/$defs/version"},
    "min_heredity_version": {"$ref": "#/$defs/version"},
    "sdk_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": {"type": "integer", "const": 1},
        "minor": {"type": "integer", "const": 0}
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "fs.read", "fs.write", "net.connect",
          "bus.call", "bus.publish", "bus.subscribe"
        ]
      }
    },
    "module": {"type": "string", "const": "module.wasm"}
  },
  "$defs": {
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[A-Za-z0-9.-]+)?$"
    }
  }
}
